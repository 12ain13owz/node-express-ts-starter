{
  "compilerOptions": {
    /* Target & Module System */
    "target": "ES2022",
    "module": "NodeNext", // Use modern Node.js ESM standards
    "moduleResolution": "NodeNext", // Resolve modules using Node.js logic
    "lib": ["ES2022"], // Set standard library APIs

    /* Path Mapping */
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"] // Map @/ alias to src directory
    },
    "rootDir": "src", // Source file location
    "outDir": "dist", // Compiled output location

    /* Strictness */
    "strict": true, // Enable all strict type-checking options
    "noImplicitAny": true, // Disallow inferred 'any' types
    "strictNullChecks": true, // Force explicit null/undefined handling
    "strictFunctionTypes": true, // Enforce stronger function type checks
    "noUnusedLocals": true, // Error on unused local variables
    "noUnusedParameters": true, // Error on unused function parameters
    "noImplicitReturns": true, // Ensure all code paths return a value
    "noFallthroughCasesInSwitch": true, // Prevent switch-case fallthrough errors

    /* Interop & Helpers */
    "esModuleInterop": true, // Smooth import of CommonJS modules
    "forceConsistentCasingInFileNames": true, // Ensure case-sensitive file naming
    "skipLibCheck": true, // Speed up build by skipping declaration checks
    "resolveJsonModule": true, // Allow importing .json files
    "removeComments": true, // Strip comments from output files

    /* Advanced */
    "declaration": false, // Skip generating .d.ts files
    "sourceMap": true, // Enable sourcemaps for better debugging
    "isolatedModules": true // Ensure compatibility with tsx/esbuild
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
