{
  "name": "node-starter",
  "version": "1.0.0",
  "description": "A modern Node.js Starter with Express, TypeScript, and ESM",
  "main": "main.ts",
  "scripts": {
    "start": "node --env-file=.env.production dist/main.js",
    "dev": "tsx --watch --env-file=.env.development src/main.ts",
    "fix": "eslint . --fix && prettier --write .",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && tsc-alias",
    "setup-env": "node scripts/setup-env.mjs"
  },
  "scripts-info": {
    "start": "Runs the compiled application in production mode using environment variables.",
    "dev": "Starts the development server with hot-reload (tsx) and development environment.",
    "fix": "Automatically fixes linting issues and formats code with Prettier.",
    "clean": "Removes the dist directory for a fresh build.",
    "build": "Compiles TypeScript to JavaScript and resolves path aliases.",
    "setup-env": "Initializes .env.dev and .env.prod files from templates."
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "Dryst",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@stoplight/elements": "^9.0.21",
    "cors": "^2.8.6",
    "dayjs": "^1.11.21",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "morgan": "^1.10.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "chalk": "^5.6.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.2",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.0"
  }
}
