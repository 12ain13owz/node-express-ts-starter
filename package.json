{
  "name": "node-starter",
  "version": "1.0.0",
  "description": "A modern Node.js Starter with Express, TypeScript, and ESM",
  "main": "main.ts",
  "scripts": {
    "start": "node --env-file=.env.production dist/main.js",
    "dev": "tsx --watch --env-file=.env.development src/main.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc && tsc-alias",
    "setup-env": "node scripts/setup-env.mjs",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "scripts-info": {
    "start": "Runs the compiled application in production mode using environment variables.",
    "dev": "Starts the development server with hot-reload (tsx) and development environment.",
    "build": "Compiles TypeScript to JavaScript and resolves path aliases.",
    "clean": "Removes the dist directory for a fresh build.",
    "setup-env": "Initializes .env.dev and .env.prod files from templates.",
    "format": "Auto-formats the entire codebase using Prettier.",
    "lint": "Checks for code quality and security issues using ESLint."
  },
  "keywords": [
    "nodejs",
    "express",
    "typescript"
  ],
  "author": "Dryst",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.0.5",
    "@typescript-eslint/eslint-plugin": "^8.52.0",
    "@typescript-eslint/parser": "^8.52.0",
    "chalk": "^5.6.2",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-security": "^3.0.1",
    "globals": "^17.0.0",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.2",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.52.0"
  },
  "dependencies": {
    "@stoplight/elements": "^7.3.9",
    "cors": "^2.8.5",
    "dayjs": "^1.11.19",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "morgan": "^1.10.1",
    "winston": "^3.19.0",
    "zod": "^4.3.5"
  }
}
